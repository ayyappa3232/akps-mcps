{
  "name": "developer-productivity-mcp",
  "version": "1.0.0",
  "description": "Developer productivity MCP server with React-based viewer and HTTP bridge",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start-mcp-inspector": "npx @modelcontextprotocol/inspector@latest node dist/index.js",
    "viewer": "vite viewer --config viewer/vite.config.ts",
    "http": "tsx watch --clear-screen=false src/httpServer.ts",
    "test": "vitest --config viewer/vite.config.ts",
    "test:watch": "vitest --config viewer/vite.config.ts",
    "test:coverage": "vitest run --config viewer/vite.config.ts --coverage",
    "test:ui": "vitest --config viewer/vite.config.ts --ui"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "productivity",
    "react",
    "typescript",
    "vitest"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@xyflow/react": "^12.12.0",
    "express": "^5.3.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}